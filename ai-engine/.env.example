# ─── TradeMind AI Engine ────────────────────
# All 3 LLM providers are FREE tier. Configure at least one.
# Priority: Groq (fastest) → NVIDIA NIM → OpenRouter

# ─── LLM Provider 1: Groq (Recommended) ─────
# Sign up: https://console.groq.com (free, instant)
# Models: Llama 3.3 70B, Llama 3.1 8B, Mixtral 8x7B
GROQ_API_KEY=

# ─── LLM Provider 2: NVIDIA NIM ─────────────
# Sign up: https://build.nvidia.com (free 1000 credits)
# Models: Llama 3.1 70B, DeepSeek R1
NVIDIA_NIM_API_KEY=

# ─── LLM Provider 3: OpenRouter ─────────────
# Sign up: https://openrouter.ai (free models available)
# Models: Llama 3.3 70B Free, DeepSeek R1 Free, Mistral 7B Free
OPENROUTER_API_KEY=

# ─── Supabase (Database) ────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Broker APIs (Optional — Future) ────────
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# ─── App Config ─────────────────────────────
DEBUG=false
